{
  "name": "portfolio-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "esbuild dist/portfolio-angular/browser/swarm-cursors.js --minify --legal-comments=inline --allow-overwrite --outfile=dist/portfolio-angular/browser/swarm-cursors.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^25.0.3",
    "esbuild": "^0.26.0",
    "jsdom": "^27.1.0",
    "sharp": "^0.34.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
