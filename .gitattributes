# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare files as text and force LF
*.xml text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
